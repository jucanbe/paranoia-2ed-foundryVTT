<section class="p2-section p2-society"><h2>{{localize "P2.Text.m15gyemk"}}</h2>
<p><strong>{{name}}</strong>{{#if hasSociety}} {{localize "P2.Text.m1degdiu"}} {{rank.level}} {{rank.label}} {{localize "P2.Text.m1degdiu"}} {{status}}{{#if exposed}} {{localize "P2.Text.m1749ko8"}}{{/if}}{{/if}}</p>
<div class="p2-society-actions">
{{#if hasSociety}}<button type="button" data-action="societyAction" data-society-operation="reference">{{localize "P2.Text.m1cn6w1o"}}</button>{{/if}}
{{#if isGM}}<button type="button" data-action="societyAction" data-society-operation="assign">{{localize "P2.Text.m1y9lmt0"}}</button>
{{#if hasSociety}}<button type="button" data-action="societyAction" data-society-operation="promote">{{localize "P2.Text.mn1lpd8"}}</button><button type="button" data-action="societyAction" data-society-operation="demote">{{localize "P2.Text.mda9ufn"}}</button><button type="button" data-action="societyAction" data-society-operation="status">{{localize "P2.Text.m1e2smc7"}}</button><button type="button" data-action="societyAction" data-society-operation="expel">{{localize "P2.Text.m1wuw9lh"}}</button><button type="button" data-action="societyAction" data-society-operation="expose">{{localize "P2.Text.mqa72nl"}}</button><button type="button" data-action="societyAction" data-society-operation="treason">{{localize "P2.Text.muqpnys"}}</button>{{/if}}
{{#if custom}}<button type="button" data-action="societyAction" data-society-operation="custom">{{localize "P2.Text.m1x943l9"}}</button>{{/if}}
{{#if psionicTraining}}<button type="button" data-action="societyAction" data-society-operation="learnPsionic">{{localize "P2.Text.m1b6tm1q"}}</button>{{/if}}
<button type="button" data-action="societyAction" data-society-operation="history">{{localize "P2.Text.m50tl61"}}</button><button type="button" data-action="societyAction" data-society-operation="gmNotes">{{localize "P2.Text.m1gfik54"}}</button>{{/if}}
</div>
<label>{{localize "P2.Text.mnkx2fe"}}<textarea name="system.secretSociety.notes" rows="3">{{notes}}</textarea></label>
{{#if hasSociety}}<details><summary>{{localize "P2.Text.m1mrqrpj"}} {{activeMissions}} {{localize "P2.Text.m1674skw"}}</summary>
{{#if isGM}}<button type="button" data-action="societyAction" data-society-operation="mission">{{localize "P2.Text.m6hyyui"}}</button>{{/if}}
{{#each missions}}<article><h3>{{title}} {{localize "P2.Text.m1degdiu"}} {{p2t statusLabel}}</h3><p>{{description}}</p><p>{{localize "P2.Text.m1k28u6o"}} {{assignedBy}}</p><p>{{localize "P2.Text.m1yylw9p"}} {{rewardNotes}}</p><p>{{localize "P2.Text.m140ugdj"}} {{consequenceNotes}}</p><p>{{secretNotes}}</p>
{{#if @root.isGM}}<button type="button" data-action="societyAction" data-society-operation="editMission" data-entry-id="{{id}}">{{localize "P2.Text.m1mo9mzd"}}</button>{{#if active}}<button type="button" data-action="societyAction" data-society-operation="resolve" data-entry-id="{{id}}">{{localize "P2.Text.mt7re4l"}}</button>{{/if}}{{/if}}</article>{{else}}<p>{{localize "P2.Text.mv9jnvm"}}</p>{{/each}}</details>
<details><summary>{{localize "P2.Text.mu0unm0"}} {{contactCount}}</summary>{{#if isGM}}<button type="button" data-action="societyAction" data-society-operation="contact">{{localize "P2.Text.mbtqoza"}}</button>{{/if}}
{{#each contacts}}<article><strong>{{name}}</strong> {{localize "P2.Text.m1degdiu"}} {{role}}<p>{{notes}}</p><p>{{trustNotes}}</p>{{#if actorUuid}}<button type="button" data-action="societyAction" data-society-operation="openContact" data-entry-id="{{id}}">{{localize "P2.Text.m8xdb0v"}}</button>{{/if}}</article>{{else}}<p>{{localize "P2.Text.m1oyqjbz"}}</p>{{/each}}</details>
<details><summary>{{localize "P2.Text.m1sxsy7r"}}</summary>{{#if isGM}}<button type="button" data-action="societyAction" data-society-operation="favor">{{localize "P2.Text.mssnha3"}}</button>{{/if}}
{{#each favors}}<p><strong>{{title}}</strong> {{localize "P2.Text.m1degdiu"}} {{p2t typeLabel}} {{localize "P2.Text.m1degdiu"}} {{description}} {{localize "P2.Text.m1degdiu"}} {{#if resolved}}{{localize "P2.Text.mebkp7g"}}{{else}}{{localize "P2.Text.mg3cg23"}} {{#if @root.isGM}}<button type="button" data-action="societyAction" data-society-operation="resolveFavor" data-entry-id="{{id}}">{{localize "P2.Text.mp1avvn"}}</button>{{/if}}{{/if}}</p>{{else}}<p>{{localize "P2.Text.medz9il"}}</p>{{/each}}</details>{{/if}}
{{#if former}}<details><summary>{{localize "P2.Text.m1194gz8"}}</summary>{{#each former}}<article><strong>{{name}}</strong> {{localize "P2.Text.m1degdiu"}} {{rank.level}} {{rank.label}} {{localize "P2.Text.m1degdiu"}} {{p2t statusLabel}}<p>{{notes}}</p>{{#each missions}}<p>{{localize "P2.Text.monxuko"}} {{title}} {{localize "P2.Text.m1degdiu"}} {{status}}<br>{{description}}<br>{{rewardNotes}}<br>{{consequenceNotes}}<br>{{secretNotes}}</p>{{/each}}{{#each contacts}}<p>{{localize "P2.Text.m17a228q"}} {{name}} {{localize "P2.Text.m1degdiu"}} {{role}} {{localize "P2.Text.m1degdiu"}} {{notes}} {{localize "P2.Text.m1degdiu"}} {{trustNotes}}</p>{{/each}}{{#each favors}}<p>{{localize "P2.Text.m1a0atnr"}} {{description}}</p>{{/each}}</article>{{/each}}</details>{{/if}}
</section>
