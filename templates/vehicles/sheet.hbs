<div class="p2-body"><div class="p2-scroll">
<header><h1>{{name}}</h1><p>{{model}} {{localize "P2.Text.m1degdiu"}} {{category}} {{localize "P2.Text.m97uaam"}} {{clearance}} {{localize "P2.Text.m1degdiu"}} <strong>{{state}}</strong></p>{{#if gm}}<label>{{localize "P2.Text.m8fqbls"}}<input name="name" value="{{name}}"></label>{{/if}}</header>
<section class="p2-vehicle-status"><strong>{{control}}</strong><span>{{movement}}</span><span>{{localize "P2.Text.m1melqf3"}} {{capacity}}</span><span>{{crewSummary}}</span>{{#if smoke}}<strong>{{localize "P2.Text.m1sw5kdl"}}</strong>{{/if}}</section>
{{#if capacityWarning}}<p>{{capacityWarning}}</p>{{/if}}
{{#if gm}}<div class="p2-health-controls"><button type="button" data-action="proposeFine">{{localize "P2.Text.m1iqjov3"}}</button><button type="button" data-action="vehicleAction" data-vehicle-action="maneuver">{{localize "P2.Text.m101y02"}}</button><button type="button" data-action="vehicleAction" data-vehicle-action="declare">{{localize "P2.Text.mtbygc6"}}</button><button type="button" data-action="vehicleAction" data-vehicle-action="attack">{{localize "P2.Text.m1xbdi6x"}}</button><button type="button" data-action="vehicleAction" data-vehicle-action="damage">{{localize "P2.Text.medpxk2"}}</button><button type="button" data-action="vehicleAction" data-vehicle-action="repair">{{localize "P2.Text.mh8tgzr"}}</button><button type="button" data-action="vehicleAction" data-vehicle-action="accident">{{localize "P2.Text.mvhukq6"}}</button><button type="button" data-action="vehicleAction" data-vehicle-action="smoke">{{localize "P2.Text.mgqy7rw"}}</button></div>{{/if}}
{{#if accidentPending}}<p class="p2-vehicle-warning"><strong>{{localize "P2.Text.m1hy0g2j"}}</strong> {{localize "P2.Text.m1ezcjhj"}}</p>{{/if}}
{{#each inventory}}<section class="p2-section"><h2>{{p2t label}}</h2>{{#if ../gm}}<button type="button" data-action="createItem" data-item-type="{{type}}">{{localize "P2.Text.m1uqem0p"}}</button>{{/if}}{{#each items}}<div class="p2-item-row draggable" data-item-id="{{id}}"><span><strong>{{name}}</strong> {{localize "P2.Text.m1degdiu"}} {{summary}}{{#if integrated}} {{localize "P2.Text.mo5gy4f"}}{{/if}}{{#if equipped}} {{localize "P2.Text.m1mlc8go"}}{{/if}}</span>{{#if ../../gm}}{{#if armor}}<button type="button" data-action="toggleArmor">{{localize "P2.Text.m1e0ouwc"}}</button>{{/if}}<button type="button" data-action="editItem">{{localize "P2.Text.mfw3ajq"}}</button><button type="button" data-action="deleteItem">{{localize "P2.Text.mra4gmp"}}</button>{{/if}}</div>{{/each}}</section>{{/each}}
{{#each rows}}<section class="p2-section"><h2>{{p2t label}}</h2>{{#if ../gm}}<button type="button" data-action="vehicleAction" data-vehicle-action="row" data-row-type="{{type}}">{{localize "P2.Text.m1uqem0p"}}</button>{{/if}}{{#each entries}}<div class="p2-item-row"><span><strong>{{name}}</strong> {{localize "P2.Text.m1degdiu"}} {{summary}}</span>{{#if ../../gm}}<button type="button" data-action="vehicleAction" data-vehicle-action="row" data-row-type="{{../type}}" data-index="{{index}}">{{localize "P2.Text.mfw3ajq"}}</button><button type="button" data-action="vehicleAction" data-vehicle-action="removeRow" data-row-type="{{../type}}" data-index="{{index}}">{{localize "P2.Text.m1gob5id"}}</button>{{/if}}</div>{{/each}}</section>{{/each}}
{{#if notes}}<section class="p2-section"><h2>{{localize "P2.Text.m1ws85s6"}}</h2><p>{{notes}}</p></section>{{/if}}
{{#if gm}}<details class="p2-section" {{#if expanded}}open{{/if}}><summary>{{localize "P2.Text.mqrwvs1"}}</summary>
<p>{{localize "P2.Text.mzn3kq9"}} {{internal.memory.used}} {{localize "P2.Text.mbo0mse"}} {{internal.memory.capacity}} {{localize "P2.Text.mmlqqbo"}} {{internal.memory.free}}{{localize "P2.Text.mtpj0mj"}}</p><button type="button" data-action="createItem" data-item-type="robotProgram">{{localize "P2.Text.md5vec4"}}</button>
{{#each internal.programs}}<div class="p2-item-row" data-item-id="{{id}}"><span>{{name}} {{localize "P2.Text.m1degdiu"}} {{level}} {{localize "P2.Text.mxeu9xz"}}</span><button type="button" data-action="vehicleAction" data-vehicle-action="program">{{#if active}}{{localize "P2.Text.md6fju8"}}{{else}}{{localize "P2.Text.mhj3cin"}}{{/if}}</button><button type="button" data-action="editItem">{{localize "P2.Text.mfw3ajq"}}</button><button type="button" data-action="deleteItem">{{localize "P2.Text.mra4gmp"}}</button></div>{{/each}}
{{#each internal.skills}}<button type="button" data-action="rollCheck" data-check-type="skill" data-check-key="{{key}}">{{p2t label}} {{value}} 🎲</button>{{/each}}
<div class="p2-vehicle-form">{{{internal.stateHTML}}}</div>{{#each internal.sections}}<h2>{{p2t label}}</h2><div class="p2-vehicle-form">{{{html}}}</div>{{/each}}
<button type="button" data-action="vehicleAction" data-vehicle-action="create">{{localize "P2.Text.m1tj3627"}}</button></details>{{/if}}
</div></div>
