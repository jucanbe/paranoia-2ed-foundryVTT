<div class="p2-body"><div class="p2-scroll"><header><h1>{{name}}</h1><p>{{p2t typeLabel}} {{model}} {{localize "P2.Text.m1degdiu"}} <strong>{{state}}</strong></p>{{#if editable}}<label>{{localize "P2.Text.m8fqbls"}}<input name="name" value="{{name}}"></label>{{/if}}</header>
{{#if gm}}<div class="p2-health-controls"><button type="button" data-action="proposeFine">{{localize "P2.Text.m1iqjov3"}}</button><button type="button" data-action="robotAction" data-robot-action="create">{{localize "P2.Text.mgwn9xs"}}</button><button type="button" data-action="robotAction" data-robot-action="declare">{{localize "P2.Text.mtbygc6"}}</button><button type="button" data-action="robotAction" data-robot-action="attack">{{localize "P2.Text.m1dnno08"}}</button><button type="button" data-action="robotAction" data-robot-action="damage">{{localize "P2.Text.medpxk2"}}</button>{{#if internal.repairable}}<button type="button" data-action="robotAction" data-robot-action="repair">{{localize "P2.Text.m12s51jg"}}</button>{{/if}}{{#if internal.shortCircuit}}<button type="button" data-action="robotAction" data-robot-action="stun">{{localize "P2.Text.mf7i0s1"}}</button>{{/if}}</div>
{{#if internal.damaged}}<p><strong>{{localize "P2.Text.mhvx9wk"}}</strong></p>{{/if}}{{#if internal.salvage}}<p>{{localize "P2.Text.mygt2vp"}}</p>{{/if}}{{#if internal.vaporized}}<p>{{localize "P2.Text.m17s1csd"}}</p>{{/if}}
<p><strong>{{localize "P2.Text.mfo0ruy"}} {{internal.asimov}}</strong>{{#if internal.erratic}} {{localize "P2.Text.m1shsy9b"}}{{/if}}</p>
<section class="p2-section"><h2>{{localize "P2.Text.m3ujxzu"}}</h2><p>{{localize "P2.Text.mtcngtb"}} <strong>{{internal.memory.used}}</strong> {{localize "P2.Text.m1utg3f0"}} <strong>{{internal.memory.capacity}}</strong> {{localize "P2.Text.mgvuz16"}} {{internal.memory.free}} {{localize "P2.Text.m1ntiwph"}}</p>
<p>{{localize "P2.Text.m10xqz72"}}</p>{{#each internal.warnings}}<p><strong>{{this}}</strong></p>{{/each}}
<div class="p2-health-controls"><button type="button" data-action="createItem" data-item-type="robotProgram">{{localize "P2.Text.m175po1k"}}</button><button type="button" data-action="robotAction" data-robot-action="swap">{{localize "P2.Text.m1wxg5mb"}}</button>{{#if internal.swap.toId}}<button type="button" data-action="robotAction" data-robot-action="finishSwap">{{localize "P2.Text.m1vgb0bp"}} {{internal.swap.readyRound}})</button><button type="button" data-action="robotAction" data-robot-action="cancelSwap">{{localize "P2.Text.m1po3enf"}}</button>{{/if}}</div>
{{#each internal.programs}}<div class="p2-item-row" data-item-id="{{id}}"><span>{{name}} {{localize "P2.Text.m1degdiu"}} {{skill}} {{level}} {{localize "P2.Text.m1degdiu"}} {{level}} {{localize "P2.Text.m1ndlsna"}} {{mode}}</span><button type="button" data-action="robotAction" data-robot-action="program">{{#if active}}{{localize "P2.Text.md6fju8"}}{{else}}{{localize "P2.Text.mnl166c"}}{{/if}}</button><button type="button" data-action="editItem">{{localize "P2.Text.mfw3ajq"}}</button><button type="button" data-action="deleteItem">{{localize "P2.Text.mra4gmp"}}</button></div>{{/each}}
<div class="p2-skills">{{#each internal.skills}}<button type="button" class="p2-check" data-action="rollCheck" data-check-type="skill" data-check-key="{{key}}">{{p2t label}} {{value}} 🎲</button>{{/each}}</div></section>
<section class="p2-section"><h2>{{localize "P2.Text.m1296ga6"}}</h2><button type="button" data-action="createItem" data-item-type="robotPeripheral">{{localize "P2.Text.m15mzy3n"}}</button>{{#each internal.peripherals}}<div class="p2-item-row" data-item-id="{{id}}"><span>{{name}} {{localize "P2.Text.m1degdiu"}} {{#if operational}}{{localize "P2.Text.m9nlce0"}}{{else}}{{localize "P2.Text.mnbnyox"}}{{/if}}<br>{{description}}</span><button type="button" data-action="editItem">{{localize "P2.Text.mfw3ajq"}}</button><button type="button" data-action="deleteItem">{{localize "P2.Text.mra4gmp"}}</button></div>{{/each}}</section>{{/if}}
{{#each inventory}}<section class="p2-section"><h2>{{p2t label}}</h2>{{#if ../gm}}<button type="button" data-action="createItem" data-item-type="{{type}}">{{localize "P2.Text.m1uqem0p"}}</button>{{/if}}{{#each items}}<div class="p2-item-row draggable" data-item-id="{{id}}"><span>{{name}} {{localize "P2.Text.m1degdiu"}} {{summary}}{{#if integrated}} {{localize "P2.Text.mo5gy4f"}}{{/if}}{{#if equipped}} {{localize "P2.Text.m1mlc8go"}}{{/if}}</span>{{#if ../../gm}}{{#if armor}}<button type="button" data-action="toggleArmor">{{localize "P2.Text.mbegq2w"}}</button>{{/if}}<button type="button" data-action="editItem">{{localize "P2.Text.mfw3ajq"}}</button><button type="button" data-action="deleteItem">{{localize "P2.Text.mra4gmp"}}</button>{{/if}}</div>{{/each}}</section>{{/each}}
{{#if gm}}<details class="p2-section"><summary>{{localize "P2.Text.mc7zuwv"}}</summary><div class="p2-secret-grid">{{#each internal.fields}}<label>{{p2t label}}{{#if choices}}<select name="{{path}}">{{#each choices}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{p2t label}}</option>{{/each}}</select>{{else if check}}<input name="{{path}}" type="checkbox" {{#if value}}checked{{/if}}>{{else if area}}<textarea name="{{path}}">{{value}}</textarea>{{else}}<input name="{{path}}" type="{{#if number}}number{{else}}text{{/if}}" value="{{value}}">{{/if}}</label>{{/each}}</div><h3>{{localize "P2.Text.m1382y0o"}}</h3><ol>{{#each internal.laws}}<li>{{this}}</li>{{/each}}</ol></details>{{/if}}</div></div>
