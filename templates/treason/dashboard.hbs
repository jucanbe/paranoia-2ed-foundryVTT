<div class="p2-treason-dashboard">
<div class="p2-treason-actions"><button type="button" data-action="command" data-operation="mission">{{localize "P2.Text.m1lpze8d"}}</button><button type="button" data-action="command" data-operation="receive">{{localize "P2.Text.mvu5xsx"}}</button><button type="button" data-action="command" data-operation="publish">{{localize "P2.Text.m587zbp"}}</button><button type="button" data-action="command" data-operation="responses">{{localize "P2.Text.m5ajvq7"}}</button></div>
<p>{{localize "P2.Text.m2wfafy"}}</p>
<h2>{{localize "P2.Text.m1b80lvk"}}</h2>
<details><summary>{{localize "P2.Text.mv400mk"}}</summary><table><thead><tr><th>{{localize "P2.Text.mew5hjn"}}</th><th>{{localize "P2.Text.mwruytu"}}</th><th>{{localize "P2.Text.m17eokj4"}}</th></tr></thead><tbody>{{#each economy}}<tr><td>{{name}}</td><td>{{balance}}</td><td><button type="button" data-action="command" data-operation="credit:reward" data-actor-uuid="{{uuid}}">{{localize "P2.Text.mju7l74"}}</button><button type="button" data-action="command" data-operation="credit:fine" data-actor-uuid="{{uuid}}">{{localize "P2.Text.m194a96"}}</button><button type="button" data-action="command" data-operation="credit:adjustment" data-actor-uuid="{{uuid}}">{{localize "P2.Text.m1b5aec1"}}</button><button type="button" data-action="command" data-operation="credit:history" data-actor-uuid="{{uuid}}">{{localize "P2.Text.m7hyx8y"}}</button></td></tr>{{/each}}</tbody></table></details>
<table><thead><tr><th>{{localize "P2.Text.mew5hjn"}}</th><th>{{localize "P2.Text.mz6498y"}}</th><th>{{localize "P2.Text.mf1j1x6"}}</th><th>{{localize "P2.Text.m17eokj4"}}</th></tr></thead><tbody>{{#each promotions}}<tr><td>{{name}}</td><td>{{current}} {{localize "P2.Text.m15ynnjp"}} {{next}}</td><td>{{progress}}<br>{{#if eligible}}{{localize "P2.Text.m11nr3xo"}}{{/if}}{{blocked}}</td><td><button type="button" data-action="command" data-operation="clearance:promote" data-actor-uuid="{{uuid}}">{{localize "P2.Text.mn1lpd8"}}</button><button type="button" data-action="command" data-operation="clearance:demote" data-actor-uuid="{{uuid}}">{{localize "P2.Text.m13m3r5"}}</button><button type="button" data-action="command" data-operation="clearance:history" data-actor-uuid="{{uuid}}">{{localize "P2.Text.m11yj5ys"}}</button></td></tr>{{/each}}</tbody></table>
<table><thead><tr><th>{{localize "P2.Text.mew5hjn"}}</th><th>{{localize "P2.Text.mgxbdtt"}}</th><th>{{localize "P2.Text.m1e2smc7"}}</th><th>{{localize "P2.Text.m17eokj4"}}</th></tr></thead><tbody>
{{#each actors}}<tr><td>{{name}}</td><td>{{#if enabled}}{{points}}{{else}}—{{/if}}</td><td>{{#if declaredTraitor}}{{localize "P2.Text.mgbu7ot"}}{{/if}}</td><td><div class="p2-treason-actions">
{{#if enabled}}<button type="button" data-action="command" data-operation="add" data-actor-uuid="{{uuid}}">{{localize "P2.Text.m1fowspm"}}</button><button type="button" data-action="command" data-operation="remove" data-actor-uuid="{{uuid}}">{{localize "P2.Text.m17rwx97"}}</button><button type="button" data-action="command" data-operation="history" data-actor-uuid="{{uuid}}">{{localize "P2.Text.m7hyx8y"}}</button><button type="button" data-action="command" data-operation="declare" data-actor-uuid="{{uuid}}">{{localize "P2.Text.m1jehwhd"}}</button>{{else}}<button type="button" data-action="command" data-operation="tracking" data-actor-uuid="{{uuid}}">{{localize "P2.Text.m10raa0k"}}</button>{{/if}}</div></td></tr>{{/each}}
</tbody></table>
<h2>{{localize "P2.Text.mlrggtd"}}</h2>{{#each inbox}}<p>{{kind}}: {{reason}} <button type="button" data-action="command" data-report-id="{{id}}">{{localize "P2.Text.m1en05s5"}}</button></p>{{else}}<p>{{localize "P2.Text.mgs0ipt"}}</p>{{/each}}
</div>
