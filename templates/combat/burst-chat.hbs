<section class="p2-roll-card"><h3>{{localize "P2.Text.m5o52og"}} {{attackerName}}</h3><p>{{weaponName}} {{localize "P2.Text.m27hz71"}} {{baseValue}} {{localize "P2.Text.mlrxbwr"}} {{targetCount}} {{localize "P2.Text.m1b5rse1"}} {{burstSkill}}</p>
{{#each shots}}<details open><summary>{{targetName}} {{localize "P2.Text.m1degdiu"}} {{attackRoll}} {{localize "P2.Text.mbo0mse"}} {{attackTarget}} {{localize "P2.Text.m1degdiu"}} {{#if hit}}{{localize "P2.Text.m8lxl1k"}}{{else}}{{localize "P2.Text.m1sdwud9"}}{{/if}}</summary><p>{{localize "P2.Text.m16ky9js"}} {{modifiers.range}} {{localize "P2.Text.m1posm0p"}} {{modifiers.wounded}} {{localize "P2.Text.m1twwgp7"}} {{modifiers.cover}} {{localize "P2.Text.my50m1f"}} {{modifiers.movement}} {{localize "P2.Text.mcf9eeg"}} {{modifiers.defenderEvading}} {{localize "P2.Text.m1vlxrhy"}} {{modifiers.gmModifier}}</p><p>{{damageStatus}}</p>{{#if damagePending}}<button type="button" data-action="resolveBurstDamage" data-shot="{{@index}}">{{localize "P2.Text.m1k5fecs"}}</button>{{/if}}</details>{{/each}}
{{#if malfunction}}<p><strong>{{localize "P2.Text.mvmv69z"}}</strong></p><button type="button" data-action="preventMalfunction" data-weapon="{{weapon}}">{{localize "P2.Text.m2z9m5h"}}</button><button type="button" data-action="repairWeapon" data-weapon="{{weapon}}">{{localize "P2.Text.m99chr1"}}</button>{{/if}}<p>{{notes}}</p></section>
