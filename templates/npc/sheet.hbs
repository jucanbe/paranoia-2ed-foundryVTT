<div class="p2-body"><div class="p2-scroll">
<header class="p2-citizen-header"><span class="p2-eyebrow">{{localize "P2.Text.m7k8i8b"}}</span><div class="p2-citizen-id">{{name}}</div>
{{#if editable}}<div class="p2-npc-tools"><button type="button" data-action="generateNPC">{{localize "P2.Text.m130jtd5"}}</button><button type="button" data-action="duplicateNPC">{{localize "P2.Text.m1fpkbjx"}}</button></div>{{/if}}
<div class="p2-identity">
<label>{{localize "P2.Text.m8fqbls"}}{{#if identity.useCitizenId}}<input name="system.identity.name" value="{{identity.name}}" placeholder="{{name}}">{{else}}<input name="name" value="{{name}}">{{/if}}</label>
<label>{{localize "P2.Text.m1m5who3"}}<output>{{p2t clearanceLabel}}</output></label>
<label>{{localize "P2.Text.mce03an"}}<input name="system.identity.sector" value="{{identity.sector}}"></label><label>{{localize "P2.Text.m1hmeo6r"}}<input name="system.cloneNumber" type="number" min="1" step="1" value="{{identity.cloneNumber}}"></label><label>{{localize "P2.Text.moatr31"}}<input name="system.service" value="{{identity.service}}"></label>
</div>{{#if editable}}<label class="p2-checkbox"><input type="checkbox" name="system.identity.useCitizenId" {{#if identity.useCitizenId}}checked{{/if}}> {{localize "P2.Text.m1arqgnv"}}</label>{{/if}}
</header>
{{{clearancePanel}}}
{{{developmentPanel}}}
<section class="p2-section"><h2>{{localize "P2.Text.m231fc3"}}</h2>{{#each health.localizedWounds}}<p>{{localize "P2.Text.m1ga7oge"}} {{p2t label}} {{localize "P2.Text.m1degdiu"}} {{p2t consequenceLabel}} {{localize "P2.Text.m1degdiu"}} {{restriction}} {{localize "P2.Text.m1degdiu"}} {{#if active}}{{localize "P2.Text.m7n1jpf"}}{{else}}{{localize "P2.Text.mfzibda"}}{{/if}}</p>{{/each}}<p><strong>{{p2t health.label}}</strong> {{#if health.stunned}}{{health.stunText}}{{/if}} {{health.woundText}}</p><p>{{localize "P2.Text.m1gchu6q"}} <strong>{{activeWeapon}}</strong> {{localize "P2.Text.m1degdiu"}} {{equippedArmor}}</p><p>{{#each combatCapacities}}{{p2t label}}: <strong>{{value}}</strong> {{localize "P2.Text.m1degdiu"}} {{/each}}</p>
{{#if isGM}}<div class="p2-npc-tools">{{#if health.localizationEnabled}}<button type="button" data-action="healthAction" data-health-action="location">{{localize "P2.Text.miawi2d"}}</button>{{/if}}<button type="button" data-action="combatAction" data-combat-action="declare">{{localize "P2.Text.mtbygc6"}}</button><button type="button" data-action="combatAction" data-combat-action="attack">{{localize "P2.Text.m1dnno08"}}</button><button type="button" data-action="healthAction" data-health-action="damage">{{localize "P2.Text.medpxk2"}}</button><button type="button" data-action="healthAction" data-health-action="state">{{localize "P2.Text.m1m5jvs0"}}</button><button type="button" data-action="attributeDuel">{{localize "P2.Text.m1tll9ye"}}</button></div>
<label>{{localize "P2.Text.m10idmoy"}}<select name="system.npc.activeWeaponId"><option value="">{{localize "P2.Text.m1aj7rmb"}}</option>{{#each secret.weapons}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{p2t label}}</option>{{/each}}</select></label>{{/if}}</section>
<section class="p2-section"><h2>{{localize "P2.Text.m1a6o55q"}}</h2><div class="p2-attributes">{{#each attributes}}<div class="p2-attribute"><button type="button" class="p2-check" data-action="rollCheck" data-check-type="attribute" data-check-key="{{key}}" title="Tirar {{p2t label}}" {{#unless ../editable}}disabled{{/unless}}>{{p2t label}} <i class="fa-solid fa-dice-d20"></i></button><input aria-label="{{p2t label}}" name="system.attributes.{{key}}.value" type="number" value="{{value}}"></div>{{/each}}</div></section>
<details class="p2-section"><summary>{{localize "P2.Text.m1sz9wqv"}}</summary><div class="p2-capabilities">{{#each capabilities}}<div class="p2-capability"><span>{{p2t label}}</span><output>{{value}}</output></div>{{/each}}</div></details>
<section class="p2-section"><h2>{{localize "P2.Text.mronet5"}}</h2><button type="button" data-action="toggleSkills">{{#if showAllSkills}}{{localize "P2.Text.m1xhohh5"}}{{else}}{{localize "P2.Text.m19l3u7k"}}{{/if}}</button><div class="p2-skills">{{#each skillGroups}}<section class="p2-skill-group"><h3>{{p2t label}}</h3>{{#each skills}}<div class="p2-value-row"><button type="button" class="p2-check" data-action="rollCheck" data-check-type="skill" data-check-key="{{key}}" title="Tirar {{p2t label}}" {{#unless ../../editable}}disabled{{/unless}}>{{p2t label}} <i class="fa-solid fa-dice-d20"></i></button><input name="system.skills.{{key}}.value" aria-label="{{p2t label}}" type="number" value="{{value}}"></div>{{else}}<p>{{localize "P2.Text.m15rjnyb"}}</p>{{/each}}</section>{{/each}}</div></section>
{{#each inventory}}<section class="p2-section"><h2>{{p2t label}}</h2>{{#if ../editable}}<button type="button" data-action="createItem" data-item-type="{{type}}">{{localize "P2.Text.m1uqem0p"}} {{p2t label}}</button>{{/if}}
{{#each items}}<div class="p2-item-row draggable" data-item-id="{{id}}"><div><strong>{{name}}</strong><br>{{summary}}{{#if equipped}} {{localize "P2.Text.m1m1d12q"}}{{/if}}{{#if assigned}} {{localize "P2.Text.m4mrpna"}}{{/if}}{{#if experimental}} {{localize "P2.Text.mgwffds"}}{{/if}}</div><span>{{quantity}}</span>{{#if ../../editable}}<div class="p2-actions"><button type="button" data-action="changeQuantity" data-delta="-1" aria-label="{{localize "P2.Text.mgmj5in"}}">−</button><button type="button" data-action="changeQuantity" data-delta="1" aria-label="{{localize "P2.Text.mskiqo2"}}">+</button>{{#if isArmor}}<button type="button" data-action="equipArmor">{{#if equipped}}{{localize "P2.Text.mj5c8je"}}{{else}}{{localize "P2.Text.m1e0ouwc"}}{{/if}}</button>{{/if}}<button type="button" data-action="editItem">{{localize "P2.Text.mfw3ajq"}}</button><button type="button" data-action="deleteItem">{{localize "P2.Text.mra4gmp"}}</button></div>{{/if}}</div>{{else}}<p>{{localize "P2.Text.m1qgrzc3"}}</p>{{/each}}</section>{{/each}}
{{#if isGM}}{{{treasonPanel}}}<details class="p2-section p2-npc-secret"><summary>{{localize "P2.Text.mk802hs"}}</summary><div class="p2-secret-grid">
<section><label>{{localize "P2.Text.m13uc8o6"}}<select name="system.npc.role">{{#each secret.roles}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{p2t label}}</option>{{/each}}</select></label><label>{{localize "P2.Text.m10xssic"}}<input name="system.npc.tags" value="{{secret.tags}}"></label><label>{{localize "P2.Text.m8adq8s"}}<textarea name="system.npc.appearance">{{secret.appearance}}</textarea></label><label>{{localize "P2.Text.m1vkyzn1"}}<textarea name="system.npc.personality">{{secret.personality}}</textarea></label><label>{{localize "P2.Text.mvtj33x"}}<textarea name="system.npc.objective">{{secret.objective}}</textarea></label><label>{{localize "P2.Text.mz4t0sw"}}<textarea name="system.npc.behavior">{{secret.behavior}}</textarea></label><label>{{localize "P2.Text.md15zz"}}<textarea name="system.npc.gmNotes" rows="4">{{secret.gmNotes}}</textarea></label></section>
<section><h3>{{localize "P2.Text.myyrzy1"}}</h3><div class="p2-value-row"><button type="button" class="p2-check" data-action="rollCheck" data-check-type="attribute" data-check-key="mutantPower">{{localize "P2.Text.m145z1aj"}}</button><input name="system.attributes.mutantPower.value" type="number" value="{{secret.powerScore}}"></div>
<label>{{localize "P2.Text.m1iy6w57"}}<select name="system.mutantPower.key"><option value="">{{localize "P2.Text.m1uhuq13"}}</option>{{#each secret.powers}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{p2t label}}</option>{{/each}}</select></label><label class="p2-checkbox"><input name="system.mutantPower.registered" type="checkbox" {{#if secret.power.registered}}checked{{/if}}> {{localize "P2.Text.mdu7man"}}</label>
<div class="p2-secret-grid"><label>{{localize "P2.Text.m1w31yc0"}}<input name="system.mutantPower.points.value" type="number" min="0" value="{{secret.powerView.points.value}}"></label><label>{{localize "P2.Text.m197tgls"}}<input name="system.mutantPower.points.max" type="number" min="0" value="{{secret.powerView.points.max}}"></label></div><div class="p2-npc-tools"><button type="button" data-action="powerAction" data-power-action="use">{{localize "P2.Text.mo5q5ja"}}</button><button type="button" data-action="powerAction" data-power-action="recover">{{localize "P2.Text.ms18kr"}}</button></div>
{{#each secret.powerView.learned}}<p>{{localize "P2.Text.m1n21qwb"}} {{p2t label}} <button type="button" data-action="powerAction" data-power-action="use" data-power-key="{{key}}">{{localize "P2.Text.m1sjgk7i"}}</button></p>{{/each}}
{{#each secret.powerView.effects}}<p>{{p2t label}} {{localize "P2.Text.m1degdiu"}} {{duration}} {{localize "P2.Text.m1degdiu"}} {{modifiers}} <button type="button" data-action="powerAction" data-power-action="end" data-effect-id="{{id}}" data-fatigue="{{fatigue}}">{{localize "P2.Text.m16wuh6j"}}</button></p>{{/each}}
<label>{{localize "P2.Text.mmqm9lz"}}<textarea name="system.mutantPower.notes">{{secret.power.notes}}</textarea></label>{{{societyPanel}}}<label>{{localize "P2.Text.mm8af0e"}}<input name="system.coverService" value="{{secret.coverService}}"></label>{{{secret.creditPanel}}}<label>{{localize "P2.Text.m19maaii"}}<textarea name="system.privateNotes">{{secret.privateNotes}}</textarea></label>
{{#if secret.nextClone}}<button type="button" data-action="activateClone">{{localize "P2.Text.m1i6iq2j"}}</button>{{/if}}</section></div></details>{{/if}}
</div></div>
